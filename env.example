# yaxaha-tests settings shared by topology/, hier/, lxc/, llm/lab/ and nightly/.
# Copy to .env (never committed) and fill in. A variable set in the shell wins.
# rmc/ and llm/ keep their own .env next to them (see rmc/env.example, llm/env.example).

# The yt-pgxt checkout to build from. Empty: a sibling of this repository.
YT_PGXT=

# The docker host for topology/ and hier/: an ssh target (key-based, no prompt),
# or local to run the containers here.
YX_HOST=local

# topology/: the SECRET every fixture node's ytserv runs with - its app key, which
# a join approval (yxctl --skv-approve, 98_skv_join.sh) is an HMAC under. A
# throwaway default is used when empty; containers take it at creation (10_up.sh).
YX_SECRET=

# lxc/: the container NIC - bridge (lxdbr0), or macvlan where Docker also runs on
# this host (its FORWARD DROP policy cuts lxdbr0 off).
YX_NIC=bridge

# llm/lab/test-yt-llm.sh: the nodes of a live cluster, "<ssh target>[/<pg port>[/<db>]]"
# separated by spaces, and an ssh key of their own when they are not in ~/.ssh/config.
YT_LLM_NODES=
YT_SSH_KEY=

# ── nightly/ ────────────────────────────────────────────────────────────────────
# The host running the rmc and topo layouts (rmc/, topo/): an ssh target, or
# empty to run them here. Its working copy, relative to its home; its own
# rmc/.env there is kept, and the nightly passes the package to test.
RMC_SSH=
RMC_DIR=rmc-run

# Where the llm suite's stack runs: an ssh target (its llm/.env and the model
# host's client certs live there), empty for here. Unset: the RMC_SSH host.
#LLM_SSH=

# The repositories whose changes trigger a run, siblings of this one (never this
# one). Empty: yt-pgxt and every local repository its build uses (cargo
# metadata), plus etcd, yaxaha_dist and infra_apt.
NIGHTLY_WATCH=

# Suites, in order: unit topology hier lxc llm topo topo-faults topo-membership rmc
NIGHTLY_SUITES="unit topology hier lxc llm topo topo-faults topo-membership rmc"

# The docker daemon the nightly's builds run on (extension, glibc/EL9/musl targets),
# in DOCKER_HOST syntax: ssh://<host> keeps them off this host. Empty: this host's.
NIGHTLY_DOCKER_HOST=

# Publish when every suite passed: 1, or 0 to build and test only.
NIGHTLY_PUBLISH=1
# The apt (reprepro) repository root, served as https://apt.dbinvent.com; the
# yum repository goes to its yum/el9.
REPO_DIR=/srv/repo
# The signing key; empty: yaxaha_dist's default.
GPG_KEY=
