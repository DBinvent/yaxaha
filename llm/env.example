# Copy to .env (never committed) and fill in. A variable set in the shell wins.

# The docker daemon to run the cluster on: the docker host's own, since the
# shell's DOCKER_HOST may point at another machine.
YTLLM_DOCKER_HOST=unix:///var/run/docker.sock

# The model service (README.md): llama.cpp behind a mutual-TLS proxy on the
# Windows box gpc, port 8080. Its server certificate is issued for that name.
LLM_HOST=gpc:8080
# Only when `gpc` does not resolve on the docker host: its address, mapped to
# the name in the node containers. Here only, never in a committed file.
LLM_HOST_IP=
# A client certificate from the model host's CA (client-cert.ps1 on the box)
LLM_CA=$HOME/llm-client/ca.crt
LLM_CLIENT_CERT=$HOME/llm-client/linux.crt
LLM_CLIENT_KEY=$HOME/llm-client/linux.key
# The model host's extra models (llm.env LLM_MODELS); sql and df use its default
LLM_MODEL_ROUTE=route
LLM_MODEL_CH=ch

# The yaxaha package for the node image: 0.16.7 or newer (R1's ClickHouse fallback).
# Empty: the newest in ../../yt-pgxt/target/debian.
YAXAHA_DEB=

# The nodes the questions are asked on: all three, or e.g. yt1
TEST_NODES="yt1 yt2 yt3"
