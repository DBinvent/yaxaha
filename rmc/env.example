# Copy to .env (never committed) and fill in. A variable set in the shell wins.

# The docker daemon to run the clusters on. Empty: the shell's own (DOCKER_HOST
# or the local socket). Running the scripts on the docker host itself is fastest:
# every check is a `docker exec`.
RMC_DOCKER_HOST=

# The yaxaha package for the node image (PostgreSQL 18). Empty: the newest in
# ../../yt-pgxt/target/debian.
YAXAHA_DEB=

# How long one step may take to settle, in seconds.
RMC_WAIT=180
# The writers' pause between two transactions, in milliseconds.
RMC_TX_MS=200
# The test network's /24: private to docker, every node at a fixed address in it.
RMC_SUBNET=10.231.7
# Where the writers send: all (every member in turn) or leader.
RMC_ORIGIN=all
# How a node added at runtime gets the data: clone (a physical copy of a member,
# ytserv's documented expansion path) or empty (no data, no position).
RMC_JOIN=clone
# ytserv's log level on every node: info, or debug to diagnose a step
RMC_LOG_LEVEL=info
